# Supabase: Project Settings → Database → Connection string → URI.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require"
# Create once with: node -e "require('bcryptjs').hash('replace-this-password', 12).then(console.log)"
ADMIN_PASSWORD_HASH=""
# Easier option for Vercel: set this directly instead of ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=""
# At least 32 random characters. Never commit the production value.
AUTH_SECRET="replace-with-a-long-random-secret"

