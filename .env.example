# For development: file:./dev.db. Use a PostgreSQL URL for production.
DATABASE_URL="file:./dev.db"
# Create once with: node -e "require('bcryptjs').hash('replace-this-password', 12).then(console.log)"
ADMIN_PASSWORD_HASH=""
# At least 32 random characters. Never commit the production value.
AUTH_SECRET="replace-with-a-long-random-secret"

